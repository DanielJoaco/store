<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.danieljoaco.storeapp.menu.loginIn.adminMenu.SearchEngineController"
            minHeight="150" minWidth="500">

    <GridPane alignment="CENTER" hgap="10" vgap="5"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="60"/>
            <ColumnConstraints percentWidth="20"/>
        </columnConstraints>

        <Label fx:id="lblTitle"
               text="Search"
               GridPane.columnIndex="1"
               GridPane.halignment="CENTER"/>

        <Label fx:id="lblSearch"
               text="item"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"
               GridPane.halignment="CENTER"/>

        <TextField fx:id="tfSearch"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

        <Button fx:id="btnSearch"
                text="Search"
                GridPane.columnIndex="2"
                GridPane.rowIndex="3"
                GridPane.halignment="CENTER"/>

        <Label fx:id="lblError"
               GridPane.columnIndex="1"
               GridPane.rowIndex="7"
               GridPane.halignment="CENTER"/>
    </GridPane>

</AnchorPane>