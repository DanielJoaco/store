<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox fx:id="loginRoot" alignment="CENTER" spacing="30" prefWidth="600" prefHeight="400"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="storeApp.menu.loginIn.LoginInController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <Label fx:id="lblTitle" text="Login In Menu">
        <font>
            <Font name="Macondo Bold" size="24" />
        </font>
    </Label>

    <Button fx:id="btnLoginAdmin" text="Login In as Admin" minWidth="200" onAction="#handleLoginAdmin" />
    <Button fx:id="btnLoginSupportAgent" text="Login In as Support Agent" minWidth="200" onAction="#handleLoginSupportAgent" />
    <Button fx:id="btnLoginCustomer" text="Login In as Customer" minWidth="200" onAction="#handleLoginCustomer" />
    <Button fx:id="btnReturnToMainMenu" text="Return to Main Menu" minWidth="200" onAction="#handleReturnToMainMenu" />
</VBox>