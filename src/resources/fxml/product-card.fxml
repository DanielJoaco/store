<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="storeApp.menu.shippingCar.ProductCardController"
      styleClass="product-card" spacing="5" alignment="CENTER"
      prefHeight="310" prefWidth="200"  maxWidth="250"  maxHeight="320" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: white;">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <VBox.margin >
        <Insets top="10" right="10" bottom="10" left="10"/>
    </VBox.margin>

    <ImageView fx:id="imageView" fitWidth="80" fitHeight="80" preserveRatio="true">
    </ImageView>

    <Label fx:id="lblName" text="Name Product" styleClass="product-title">
        <font>
            <Font name="System Bold" size="14"/>
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnReduce" text="-" prefWidth="20" onAction="#reduceQuantity"/>
        <Label fx:id="lblQuantity" text="1" style="-fx-background-color: #f4f4f4; -fx-padding: 5;" minWidth="20" alignment="CENTER"/>
        <Button fx:id="btnAdd" text="+" prefWidth="25" prefHeight="20" onAction="#addQuantity"/>
    </HBox>

    <Label text="Price:" styleClass="price-label">
        <font>
            <Font size="12"/>
        </font>
    </Label>

    <Label fx:id="lblPrice" text="0.0" style="-fx-background-color: #f4f4f4; -fx-padding: 5;" maxHeight="20">
        <font>
            <Font name="System Bold" size="12"/>
        </font>
    </Label>

    <Button fx:id="btnAddToCart" text="Add to Cart" styleClass="add-cart-button" maxWidth="200" onAction="#addToCart"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>

    <Label fx:id="lblErrorMessage" styleClass="error-label" textFill="#2e7d32"
           style="-fx-padding: 5; -fx-background-color: #E8F5E9; -fx-background-radius: 3;"
           wrapText="true" alignment="CENTER" visible="false"/>
</VBox>