<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.danieljoaco.storeapp.menu.shippingCar.ProductCardController"
            prefHeight="310" prefWidth="120">
    <VBox GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="product-card" spacing="5" alignment="CENTER">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <ImageView  fx:id="imageView" fitWidth="150" fitHeight="150" preserveRatio="true">
        </ImageView>
        <Label fx:id="lblName" text="Name Product" styleClass="product-title">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        <HBox alignment="CENTER" spacing="10">
            <Button onAction="#reduceQuantity" fx:id="btnReduce" text="-" prefWidth="30"/>
            <Label fx:id="lblQuantity" text="1" style="-fx-background-color: #f4f4f4 ;" minWidth="20" alignment="CENTER"/>
            <Button onAction="#addQuantity"  fx:id="btnAdd" text="+" prefWidth="30"/>
        </HBox>
        <Label fx:id="lblPrice" text="0.0" style="-fx-background-color: #f4f4f4 ;">

        <font>
                <Font name="System Bold" size="16"/>
            </font>
        </Label>
        <Button onAction="#addToCart" text="Add to Cart" styleClass="add-cart-button" maxWidth="Infinity"/>
        <Label fx:id="lblErrorMessage" styleClass="error-label"/>
    </VBox>

</AnchorPane>
