<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="mainBox" alignment="CENTER" prefHeight="304.0" prefWidth="372.0" spacing="15" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.danieljoaco.storeapp.MainController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <Button fx:id="btnRegister" minWidth="150" onAction="#handleRegister" prefHeight="36.0" prefWidth="172.0" text="Sing Up" />
    <Button fx:id="btnLogin" minWidth="150" onAction="#handleLogin" prefHeight="40.0" prefWidth="168.0" text="Login In" />
    <Button fx:id="btnExit" minWidth="150" onAction="#handleExit" prefHeight="37.0" prefWidth="172.0" text="Exit" />
</VBox>
