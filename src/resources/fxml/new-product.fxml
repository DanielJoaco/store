<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.danieljoaco.storeapp.menu.adminMenu.NewProductController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <GridPane fx:id="grid" alignment="CENTER" hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
        </columnConstraints>

        <Label styleClass="title-label" text="New product" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="0" />

        <Label text="Name:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Ref:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="refField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Cost:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="costField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Price:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label text="Stock:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="stockField" GridPane.columnIndex="1" GridPane.rowIndex="6" />

        <Label text="Bill:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <TextField fx:id="billField" GridPane.columnIndex="1" GridPane.rowIndex="7" />

        <Label text="Category:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="8" />
        <ComboBox fx:id="categoryComboBox" prefWidth="250" promptText="Select a category" GridPane.columnIndex="1" GridPane.rowIndex="8" />

        <Label text="Subcategory:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="9" />
        <ComboBox fx:id="subcategoryComboBox" prefWidth="250" promptText="Select a subcategory" GridPane.columnIndex="1" GridPane.rowIndex="9" />

        <Button fx:id="createButton" onAction="#handleCreate" text="Create" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="10" />

        <Label fx:id="lblError" styleClass="error-label" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="11" />
    </GridPane>
</VBox>