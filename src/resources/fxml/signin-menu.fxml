<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox fx:id="signInRoot" alignment="CENTER" spacing="30" prefWidth="600" prefHeight="400"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="storeApp.menu.signUp.SignUpMenuController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <Label fx:id="lblTitle" text="Sign Up Menu">
        <font>
            <Font name="Macondo Bold" size="30" />
        </font>
    </Label>

    <Button fx:id="btnCreateCustomer" text="Create Customer" minWidth="200" onAction="#handleCreateCustomer" />
    <Button fx:id="btnCreateSupportAgent" text="Create Support Agent" minWidth="200" onAction="#handleCreateSupportAgent" />
    <Button fx:id="btnCreateAdmin" text="Create Admin" minWidth="200" onAction="#handleCreateAdmin" />
    <Button fx:id="btnReturnToMainMenu" text="Return to main menu" minWidth="200" onAction="#handleReturnToMainMenu" />

    <Label fx:id="lblError" wrapText="true" textAlignment="CENTER" />
</VBox>