<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox fx:id="confirmationRoot" alignment="CENTER" spacing="20" prefWidth="300" prefHeight="200"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.danieljoaco.storeapp.menu.utils.ConfirmationDialogController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <Label fx:id="lblConfirmText" textAlignment="CENTER" wrapText="true">
        <font>
            <Font name="Macondo Bold" size="24" />
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnYes" text="Yes" onAction="#handleYes" minWidth="80" />
        <Button fx:id="btnNo" text="No" onAction="#handleNo" minWidth="80" />
    </HBox>
</VBox>